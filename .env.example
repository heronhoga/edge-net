# Copy this file to .env; the Go API loads it automatically at startup.
# Existing environment variables take precedence over values in .env.
# Public origin opened in the browser (no trailing path).
# Production must use HTTPS. For a single-server local build, use http://localhost:8080.
APP_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: enables the separate local-admin workspace, including existing devices.
# Leave blank for Google-only sign-in. If set, use a random secret of at least 16 characters.
ADMIN_TOKEN=
LISTEN_ADDR=:8080
DATA_DIR=data
